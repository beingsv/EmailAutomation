# Database
# SQLite is used by default. For PostgreSQL, update the provider in prisma/schema.prisma
# and change DATABASE_URL to a PostgreSQL connection string.
DATABASE_URL=file:./dev.db

# NextAuth
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Ollama Cloud API
# Get your API key from https://ollama.com
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud

# Encryption (32-byte hex string for AES-256-GCM)
# Used to encrypt SMTP credentials at rest
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
